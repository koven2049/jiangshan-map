<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/admin</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.koven.jiangshan-map</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/python@3.13/libexec/bin/python3</string>
		<string>server.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/admin/Services/jiangshan-map/run/server.log</string>
	<key>StandardOutPath</key>
	<string>/Users/admin/Services/jiangshan-map/run/server.log</string>
	<key>UserName</key>
	<string>admin</string>
	<key>WorkingDirectory</key>
	<string>/Users/admin/Services/jiangshan-map</string>
</dict>
</plist>
